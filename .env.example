# LearnX environment configuration TEMPLATE.
#
# Copy this file to `.env` and fill in real values for local development.
# `.env` is gitignored; this template is committed so the required keys are
# documented without exposing secrets.
#
# NOTE: The app backend is Firebase. The Supabase keys below are reserved for a
# possible future integration and are not consumed by the app yet.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Supabase anon/public key. Only safe on the client when Row Level Security
# (RLS) is enabled on the project. Never commit the real value.
SUPABASE_ANON_KEY=
