# LearnX Cloud Functions environment TEMPLATE. Copy to `.env` for local runs.
#
# The AI_Proxy uses Vertex AI (service-account / ADC auth), so there is NO API
# key here. Authenticate locally with: gcloud auth application-default login

# GCP project that owns Vertex AI (auto-set in deployed functions).
GOOGLE_CLOUD_PROJECT=

# Vertex AI region (default: us-central1).
VERTEX_LOCATION=us-central1

# Gemini model id (default: gemini-1.5-flash).
GEMINI_MODEL=gemini-1.5-flash

# Optional overrides (defaults: gemini-1.5 / keyword-v1).
# AI_PROVIDER_ID=gemini-1.5
# MODERATOR_ID=keyword-v1
